# --- Первая проходная (создаётся один раз на пустой базе) ---
TURNSTILE_HOST=192.168.1.100
TURNSTILE_NAME=КПП-1
TURNSTILE_PORT=80
TURNSTILE_PASSWORD=

# --- Релей (только macOS + Docker Desktop) ---
# На Linux оставьте пустым: сервис подключается к турникетам напрямую.
# Пример для macOS:
# TURNSTILE_RELAY_ENDPOINT=host.docker.internal:9000
# TURNSTILE_RELAY_TOKEN=... (сгенерируйте: openssl rand -hex 16)
# RELAY_ALLOWED_NETWORKS=10.3.198.0/24
# RELAY_ALLOWED_PORTS=80
TURNSTILE_RELAY_ENDPOINT=
TURNSTILE_RELAY_TOKEN=
RELAY_ALLOWED_NETWORKS=
RELAY_ALLOWED_PORTS=80

# --- Сбор событий ---
# Период опроса журналов, секунды
POLL_INTERVAL=2

# Глубина импорта истории при первом запуске (0 = вся история)
BACKFILL_DAYS=30

# Категории событий (0 = «Доступ по идентификатору»)
EVENT_CATEGORIES=0
